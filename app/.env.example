# AG-UI Server Configuration (GitHub Copilot SDK)

# GitHub App OAuth credentials. Production callback:
# https://app-agentic-devops.azurewebsites.net/auth/callback
# COPILOT_APP_CLIENT_ID=
# COPILOT_APP_CLIENT_SECRET=

# AG-UI Client Configuration
AGUI_SERVER_URL=http://127.0.0.1:5100/

# Server settings (all optional — defaults shown)
# COPILOT_API_HOST=0.0.0.0
# COPILOT_API_PORT=5100
# COPILOT_API_LOG_LEVEL=INFO
# COPILOT_API_SESSION_TIMEOUT=120.0
# COPILOT_API_ISOLATION_SESSION_HEADER=X-Isolation-Session-ID
# COPILOT_API_SESSION_CONFIG_ROOT_DIR=.copilot-session-config
# COPILOT_API_TOOL_TIMEOUT=10.0
# COPILOT_API_TOOL_EXTERNAL_API_URL=https://api.github.com/zen

# SDK built-in tool policy (optional)
# Denylist applied to every session. Unset = secure-by-default denylist below.
# Set to a blank value to disable the denylist. Ignored if an allowlist is set.
# COPILOT_API_EXCLUDED_TOOLS=bash,write_bash,read_bash,stop_bash,list_bash,view,create,edit,grep,glob,sql
# Allowlist takes precedence over the denylist when set.
# COPILOT_API_ALLOWED_TOOLS=

# Azure Monitor Tracing (optional)
# When set, traces, logs, and metrics are exported to Azure Application
# Insights via OpenTelemetry. Leave unset to disable tracing in local dev.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/
# Optional: override the service name reported on every span.
# OTEL_SERVICE_NAME=agentic-devops-starter

# GitHub Copilot CLI OpenTelemetry (optional)
# Enables telemetry from the Copilot CLI subprocess spawned by the
# github-copilot-sdk. Send this to an OpenTelemetry Collector that exports to
# Application Insights, then use the GitHub Copilot Grafana dashboard.
# COPILOT_API_CLI_OTEL_ENDPOINT=http://localhost:4318
# COPILOT_API_CLI_OTEL_EXPORTER_TYPE=otlp-http
# COPILOT_API_CLI_OTEL_SOURCE_NAME=agentic-devops-starter
# Set to true only after reviewing prompt/response content capture policies.
# COPILOT_API_CLI_OTEL_CAPTURE_CONTENT=false
# Optional local JSON-lines exporter for diagnostics instead of OTLP.
# COPILOT_API_CLI_OTEL_FILE_PATH=/tmp/copilot-otel.jsonl

# Azure Blob Storage (required for file upload feature)
# COPILOT_API_AZURE_STORAGE_BLOB_ENDPOINT=https://<account>.blob.core.windows.net
# COPILOT_API_AZURE_STORAGE_CONTAINER_NAME=uploads

# Azure AI Foundry BYOK (used only when the frontend Model selector is Foundry)
# AZURE_AI_PROJECT_ENDPOINT=https://jinspark-kr-foundry.services.ai.azure.com
# AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.3-codex
# FOUNDRY_AUTH_MODE=azure_identity  # auto | api_key | azure_identity
# FOUNDRY_API_KEY=<foundry-api-key>  # required only when FOUNDRY_AUTH_MODE=api_key
# FOUNDRY_WIRE_API=responses

# Remote MCP (Model Context Protocol) server (optional)
# When set, tools exposed by the MCP server are fetched at startup and made
# available to all agent sessions alongside the built-in code-based tools.
# MCP loading is non-fatal — the server starts with only built-in tools when
# the endpoint is unreachable.
# Both variable names are accepted; MCP_SERVER_URL takes precedence.
# MCP_SERVER_URL=https://<your-mcp-server>.azurecontainerapps.io
# COPILOT_API_MCP_SERVER_URL=https://<your-mcp-server>.azurecontainerapps.io

# Azure App Configuration (optional — for feature flags)
# When set, key-values are loaded from Azure App Configuration at startup with
# lower precedence than environment variables (env vars always win).
# The App Service managed identity must have the "App Configuration Data Reader"
# role on the App Configuration resource.
# COPILOT_API_APP_CONFIG_ENDPOINT=https://<your-store>.azconfig.io
# COPILOT_API_APP_CONFIG_LABEL=production
